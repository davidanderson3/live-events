{
  "name": "decision-maker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run sync:public",
    "validate": "npm run build && npm run test:stability",
    "validate:staging": "npm run validate && npm run benchmark:local",
    "validate:full": "npm run validate && npm run e2e",
    "purge:css": "purgecss --config purgecss.config.js --output ./clean-css",
    "test": "vitest run",
    "test:stability": "vitest run --config vitest.stability.config.js",
    "e2e": "playwright test",
    "smoke:local": "playwright test tests/e2e/local-smoke.spec.ts",
    "benchmark:local": "playwright test tests/e2e/local-smoke.spec.ts --grep \"fresh incognito-style contexts\"",
    "import:travel": "node scripts/importTravelKml.js",
    "append:travel": "node scripts/appendTravelKml.js",
    "update:geo": "node scripts/addGeoMetadata.js",
    "monitor:temp": "node scripts/tempAlert.js",
    "generate:geoscore": "node scripts/generateGeoscoreQuestions.js",
    "refresh:static-bootstrap": "node scripts/updateStaticShowsBootstrap.js",
    "backfill:review-queue": "node scripts/backfillReviewQueueFields.js",
    "update:cities": "node scripts/populateCities.js",
    "prepare": "husky install",
    "start": "HOST=${HOST:-127.0.0.1} YOUTUBE_API_KEY=${YOUTUBE_API_KEY:-skip} PORT=${PORT:-3004} SHOWS_BACKGROUND_REFRESH_ENABLED=${SHOWS_BACKGROUND_REFRESH_ENABLED:-false} node functions/backend/server.js",
    "start:gcloud": "HOST=${HOST:-127.0.0.1} YOUTUBE_API_KEY=${YOUTUBE_API_KEY:-$(gcloud secrets versions access latest --secret=YOUTUBE_API_KEY 2>/dev/null | tr -d '\\n')} PORT=${PORT:-3004} node functions/backend/server.js",
    "sync:public": "node scripts/syncPublic.js",
    "deploy:web:staging": "npm run validate:staging && firebase deploy --only functions,hosting:web-staging --project live-events-6f3e5",
    "deploy:web:prod": "npm run validate:full && firebase deploy --only functions,hosting:web-prod --project live-events-6f3e5",
    "cleanup:function-artifacts": "firebase functions:artifacts:setpolicy --days 1 --project live-events-6f3e5",
    "watch": "node scripts/watchAndDeploy.js",
    "watch:deploy": "node scripts/watchAndDeploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^4.5.3",
    "firebase": "^11.8.1",
    "firebase-admin": "^13.4.0",
    "nodemailer": "^6.9.8",
    "plaid": "^37.0.0",
    "playwright": "^1.54.1",
    "twilio": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "husky": "^8.0.0",
    "jsdom": "^26.1.0",
    "purgecss": "^7.0.2",
    "supertest": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
