# Copy to `.env` and fill in the values you actually use.

# Firebase project ID — required for local dev so Admin SDK writes to the right Firestore
GCLOUD_PROJECT=live-events-6f3e5

# SMTP email delivery for contact + venue feedback
CONTACT_EMAIL=alerts@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASS=replace-me

# Optional convenience settings
SMTP_FROM=alerts@example.com
SMTP_FROM_NAME=DMV Events
SMTP_TO=alerts@example.com

# Alternative to SMTP_HOST/PORT if you use a well-known provider
# SMTP_SERVICE=gmail
